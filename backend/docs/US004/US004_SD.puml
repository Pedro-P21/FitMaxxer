@startuml US004-SD
autonumber
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as Actor
participant "Flutter App" as UI
participant ":JWT Authentication Filter" as Auth
participant ":DailyLogController" as Ctrl
participant ":DailyLogApplicationService" as Svc
participant ":DailyLogRepository" as LogRepo
participant ":UserNutritionalProfileRepository" as ProfileRepo
participant ":FoodCatalogQueryService (US003)" as FoodQuery
participant ":FoodCatalogDetailsDTO (temporary)" as FoodDetailsDTO
participant ":DailyLogFactory" as LogFactory
participant ":MealItemFactory" as ItemFactory
participant ":NutrientScalingService" as Scaling
participant ":DailyLog" as DailyLog
participant ":MealItem" as MealItem
participant ":FoodSnapshot (Value Object)" as FoodSnapshot
participant ":PortionQuantity (Value Object)" as Portion
participant ":MealType (Value Object)" as MealType
participant ":DailyLogMapper" as Mapper
participant ":AddMealItemRequestDTO" as RequestDTO
participant ":DailyLogResponseDTO" as ResponseDTO


activate Actor
Actor -> UI : opens today's food log
activate UI
UI -> Auth : GET /api/daily-log/today\nAuthorization: Bearer <access-token>
activate Auth
Auth -> Auth : validate token and build principal from sub
Auth -> Ctrl : forward request with authenticated userId
activate Ctrl
deactivate Auth

Ctrl -> Svc : getToday(userId, currentDate)
activate Svc
Svc -> LogRepo : findByUserIdAndDate(userId, currentDate)
activate LogRepo
LogRepo --> Svc : Optional<DailyLog>
deactivate LogRepo

alt DailyLog exists
  Svc -> Mapper : toResponseDTO(dailyLog)
  activate Mapper
  Mapper -> ResponseDTO : map meals, target snapshot, and progress
  activate ResponseDTO
  ResponseDTO --> Mapper : response DTO
  deactivate ResponseDTO
  Mapper --> Svc : response DTO
  deactivate Mapper
else No DailyLog exists yet
  Svc -> ProfileRepo : findByUserId(userId)
  activate ProfileRepo
  ProfileRepo --> Svc : UserNutritionalProfile
  deactivate ProfileRepo
  note right of Svc
    Read current goals for the empty view.
    Do not create or persist an empty DailyLog.
  end note
  Svc -> Svc : read goal values for the empty view
  Svc -> Mapper : toEmptyResponseDTO(currentDate, profile goals)
  activate Mapper
  Mapper -> ResponseDTO : map empty meals, targets, zero intake
  activate ResponseDTO
  ResponseDTO --> Mapper : response DTO
  deactivate ResponseDTO
  Mapper --> Svc : response DTO
  deactivate Mapper
end

Svc --> Ctrl : DailyLogResponseDTO
deactivate Svc
Ctrl --> UI : 200 OK + response DTO
deactivate Ctrl
UI --> Actor : displays today's log and progress

Actor -> UI : searches/selects food using US003
UI --> Actor : displays food and catalog serving
Actor -> UI : selects meal type and serving quantity
UI -> Auth : POST /api/daily-log/today/items\n(body: foodId, mealType, servingQuantity)\nAuthorization: Bearer <access-token>
activate Auth
Auth -> Auth : validate token and build principal from sub
Auth -> Ctrl : forward request with authenticated userId
activate Ctrl
deactivate Auth

Ctrl -> RequestDTO : bind JSON body and validate required fields
activate RequestDTO
RequestDTO --> Ctrl : AddMealItemRequestDTO
deactivate RequestDTO
Ctrl -> Svc : addMealItem(userId, requestDTO)
activate Svc
Svc -> FoodQuery : getFoodDetails(catalogLookupKey)
activate FoodQuery
FoodQuery -> FoodDetailsDTO : map catalog result to temporary DTO
activate FoodDetailsDTO
FoodDetailsDTO --> FoodQuery : food details DTO
deactivate FoodDetailsDTO
FoodQuery --> Svc : FoodCatalogDetailsDTO
deactivate FoodQuery

Svc -> LogRepo : findByUserIdAndDate(userId, currentDate)
activate LogRepo
LogRepo --> Svc : Optional<DailyLog>
deactivate LogRepo

alt DailyLog exists
  note right of Svc
    Reuse the existing aggregate and its goal snapshot.
  end note
else First item today
  Svc -> ProfileRepo : findByUserId(userId)
  activate ProfileRepo
  ProfileRepo --> Svc : UserNutritionalProfile
  deactivate ProfileRepo
  Svc -> Svc : extract profileId and copy calorie/macro targets
  Svc -> LogFactory : create(userId, currentDate, profileId, goalSnapshot)
  activate LogFactory
  LogFactory -> DailyLog : construct DailyLog with identity and target snapshot
  activate DailyLog
  DailyLog --> LogFactory : new DailyLog
  deactivate DailyLog
  LogFactory --> Svc : new DailyLog
  deactivate LogFactory
end

Svc -> ItemFactory : create(foodDetailsDTO, servingQuantity)
activate ItemFactory
ItemFactory -> FoodSnapshot : create copied food details
activate FoodSnapshot
FoodSnapshot --> ItemFactory : immutable snapshot VO
deactivate FoodSnapshot
ItemFactory -> Portion : create positive catalog-serving quantity
activate Portion
Portion --> ItemFactory : validated PortionQuantity
deactivate Portion
ItemFactory -> MealItem : create(FoodSnapshot, PortionQuantity)
activate MealItem
MealItem --> ItemFactory : MealItem entity
deactivate MealItem
ItemFactory --> Svc : MealItem
deactivate ItemFactory

Svc -> DailyLog : addMealItem(mealType, mealItem)
activate DailyLog
DailyLog -> MealType : validate/create supported meal type
activate MealType
MealType --> DailyLog : validated MealType
deactivate MealType
DailyLog -> Scaling : calculateContribution(mealItem snapshot, servingQuantity)
activate Scaling
Scaling --> DailyLog : validated calories and macros for this item
deactivate Scaling
DailyLog -> DailyLog : enforce meal type rules and add to meal
DailyLog -> DailyLog : calculate meal and daily totals / remaining targets
DailyLog --> Svc : updated DailyLog and progress
deactivate DailyLog

Svc -> LogRepo : save(dailyLog)
activate LogRepo
LogRepo --> Svc : saved DailyLog
deactivate LogRepo

Svc -> Mapper : toResponseDTO(savedDailyLog)
activate Mapper
Mapper -> ResponseDTO : map meals, totals, targets, and remaining values
activate ResponseDTO
ResponseDTO --> Mapper : response DTO
deactivate ResponseDTO
Mapper --> Svc : response DTO
deactivate Mapper

Svc --> Ctrl : DailyLogResponseDTO
deactivate Svc
Ctrl --> UI : 200 OK + updated response DTO
deactivate Ctrl
UI --> Actor : displays added food and updated progress
deactivate UI
deactivate Actor

note over LogFactory,DailyLog
  DDD boundary: DailyLog owns Meal and MealItem entities.
  Each MealItem owns FoodSnapshot and PortionQuantity value objects. The
  log does not store FoodItem, FoodId, or the temporary catalog DTO. An
  optional barcode is copied into FoodSnapshot as descriptive metadata.
  DailyLog stores the profile ID and immutable goal snapshot, not the
  UserNutritionalProfile aggregate object. US004 only adds items; edits
  and removals are handled by US009.
end note

== Validation and failure behavior ==
note over Auth,LogRepo
  Authentication failures stop before the controller. Invalid meal types,
  non-positive serving quantities, missing catalog data, or incompatible
  nutrient bases return a clear client error and do not persist a partial log.
  Repository failures return a service error; transaction rollback prevents
  a newly created log without its first valid item.
end note
@enduml
