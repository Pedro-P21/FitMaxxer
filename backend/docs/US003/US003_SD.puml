@startuml US003_SD
autonumber
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as Actor
participant "Flutter App" as UI
participant ":JWT Authentication Filter" as Auth
participant ":FoodCatalogController" as Ctrl
participant ":FoodCatalogSearchService" as Search
participant "Spring Cache Interceptor" as CacheProxy
participant ":foodSearchCache" as SearchCache
participant ":FoodCatalogAggregatorService" as Svc
participant ":OpenFoodFactsAdapter" as Adapter
participant ":OpenFoodFactsClient" as Client
participant "Open Food Facts API" as OFF
participant ":OpenFoodFactsMapper" as Mapper
participant ":FoodItemFactory" as Factory
participant ":FoodCatalogResponseMapper" as ResponseMapper
participant ":FoodDetailsCache" as Details
participant ":foodDetailsCache" as DetailsCache

activate Actor
Actor -> UI : enters keyword or barcode
activate UI
UI -> Auth : GET /api/foods?query={keywordOrBarcode}\nAuthorization: Bearer <access-token>
activate Auth
Auth -> Auth : authenticate and establish principal
Auth -> Ctrl : forward authenticated request
activate Ctrl
deactivate Auth

Ctrl -> Search : search(query)
activate Search
note over CacheProxy: this happens automatically managed by spring framework
Search -> CacheProxy : search(query)
activate CacheProxy
CacheProxy -> SearchCache : get(query.trim().toLowerCase())
activate SearchCache
SearchCache --> CacheProxy : cached response or cache miss
deactivate SearchCache

alt Search cache hit
    note right of CacheProxy
        Reuse the cached FoodCatalogResponseDTO.
        The aggregator method body is skipped.
    end note
else Search cache miss
    CacheProxy -> Svc : search(query)
    activate Svc
    loop Each configured provider (currently Open Food Facts)
        Svc -> Adapter : search(query.trim())
        activate Adapter
        Adapter -> Client : search(query) / findByBarcode(query)
        activate Client
        Client -> OFF : HTTPS keyword search or barcode lookup
        activate OFF
        OFF --> Client : product JSON
        deactivate OFF
        Client -> Client : deserialize response into provider DTOs
        Client --> Adapter : provider DTOs
        deactivate Client
        Adapter -> Mapper : toDomainItems(response) / toDomainItem(product)
        activate Mapper
        loop Each usable product
            Mapper -> Factory : createFoodItem(id, name, brand, barcode,\nnutrients, basis, serving quantity and unit)
            activate Factory
            Factory --> Mapper : FoodItem with value objects
            deactivate Factory
        end
        Mapper --> Adapter : normalized food items
        deactivate Mapper
        Adapter --> Svc : List<FoodItem>
        deactivate Adapter
    end
    Svc -> Svc : merge and deduplicate by food ID
    Svc -> ResponseMapper : toResponseDTO(foodItems)
    activate ResponseMapper
    ResponseMapper --> Svc : FoodCatalogResponseDTO
    deactivate ResponseMapper
    Svc --> CacheProxy : FoodCatalogResponseDTO
    deactivate Svc
    CacheProxy -> SearchCache : put(normalized query, response)
    activate SearchCache
    SearchCache --> CacheProxy
    deactivate SearchCache
end

CacheProxy --> Search : FoodCatalogResponseDTO
deactivate CacheProxy

loop Each food in the response (also on search cache hits)
    Search -> Details : put(foodItemDTO)
    activate Details
    Details -> DetailsCache : put(food.foodId(), food)
    activate DetailsCache
    DetailsCache --> Details
    deactivate DetailsCache
    Details --> Search
    deactivate Details
end

Search --> Ctrl : FoodCatalogResponseDTO
deactivate Search
Ctrl --> UI : 200 OK + normalized food results
deactivate Ctrl
UI --> Actor : displays matching foods

opt User selects a result to inspect details
    Actor -> UI : selects food
    UI --> Actor : displays available nutritional breakdown
end

deactivate UI
deactivate Actor
@enduml
