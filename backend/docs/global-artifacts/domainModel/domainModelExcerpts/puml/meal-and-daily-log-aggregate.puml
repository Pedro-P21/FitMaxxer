@startuml "meal_and_daily_log_aggregate"

top to bottom direction
skinparam linetype ortho
hide circle
skinparam nodesep 40
skinparam ranksep 80
skinparam padding 10

package "Meal & Daily Log Aggregate" {
    class DailyLog <<Entity Root>> {}
    class DailyLogId <<Value Object>>  {}
    class LogDate <<Value Object>> {}
    class DailyGoalSnapshot <<Value Object>> {}
    class DailyNutritionSummary <<Value Object>> {}
    class Meal <<Entity>> {}
    class MealType <<Value Object>> {}
    class MealItem <<Entity>> {}
    class FoodSnapshot <<Value Object>> {}
    class PortionQuantity <<Value Object>> {}
}

DailyLog "1" *-- "1" DailyLogId
DailyLog "1" *-- "1" LogDate
DailyLog "1" *-- "1" DailyGoalSnapshot : "calorie and macro targets for this day"
DailyLog ..> DailyNutritionSummary : "calculates consumed, target, and remaining values"
DailyLog "1" --> "1" User : "belongs to"
DailyLog "1" *-- "0..*" Meal
DailyLog "1" --> "1" UserNutritionalProfile: "references"

Meal "1" *-- "1" MealType
Meal "1" *-- "0..*" MealItem

MealItem "1" *-- "1" FoodSnapshot
MealItem "1" *-- "1" PortionQuantity


@enduml

