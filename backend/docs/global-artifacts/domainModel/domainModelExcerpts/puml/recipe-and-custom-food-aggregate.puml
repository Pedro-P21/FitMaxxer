@startuml "recipe_and_custom_food_aggregate"

top to bottom direction
skinparam linetype ortho
hide circle
skinparam nodesep 40
skinparam ranksep 80
skinparam padding 10



package "Recipe & Custom Food Aggregate" {
    class CustomRecipe <<Entity Root>> {
        numberOfServings : Decimal
    }
    class RecipeMacros <<Entity>> {}
    class RecipeId <<Value Object>>  {}
    class RecipeName <<Value Object>> {}
    class RecipeIngredients <<Entity>> {}
    class IngredientSnapshot <<Value Object>> {}
    class IngredientQuantity <<Value Object>> {}
}

CustomRecipe "1" *-- "1" RecipeId
CustomRecipe "1" *-- "1" RecipeName
CustomRecipe "1" *-- "1" RecipeMacros : "whole-recipe totals"
CustomRecipe "1" *-- "1..*" RecipeIngredients
CustomRecipe "1" --> "1" User : "created by"

MealItem "1" --> "0..1" CustomRecipe : "can be"

RecipeIngredients "1" *-- "1" IngredientSnapshot
RecipeIngredients "1" *-- "1" IngredientQuantity

note bottom of RecipeMacros
  Sum of scaled ingredient calories and macros.
  Owned by CustomRecipe; no independent lifecycle.
  Per-serving values = totals / numberOfServings.
end note

@enduml
