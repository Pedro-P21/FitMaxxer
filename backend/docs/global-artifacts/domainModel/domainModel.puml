@startuml "Domain_Model"

top to bottom direction
skinparam linetype ortho
hide circle
skinparam nodesep 40
skinparam ranksep 80
skinparam padding 10

package "User Authentication Aggregate" {
    class User <<Entity Root>> {}
    class UserId <<Value Object>> {}
    class Email <<Value Object>> {}
    class Password <<Value Object>> {}
}

package "User Profile Aggregate" {
    class UserNutritionalProfile <<Entity Root>> {}
    class PhysicalData <<Value Object>> {}
    class ActivityLevel <<Value Object>> {}
    class NutritionalGoal <<Entity>> {}
    class MacroBreakdown <<Value Object>> {}

}

package "Food Catalog Aggregate" {
    class FoodItem <<Entity Root>> {}
    class FoodId <<Value Object>>  {}
    class ProductName <<Value Object>> {}
    class Barcode <<Value Object>> {}
    class NutrientComposition <<Entity>> {}
    class ServingSize <<Value Object>> {}
    class Brand <<Value Object>>{}
}

package "Recipe & Custom Food Aggregate" {
    class CustomRecipe <<Entity Root>> {}
    class RecipeId <<Value Object>>  {}
    class RecipeName <<Value Object>> {}
    class RecipeIngredients <<Value Object>> {}
}

package "Meal & Daily Log Aggregate" {
    class DailyLog <<Entity Root>> {}
    class DailyLogId <<Value Object>>  {}
    class LogDate <<Value Object>> {}
    class Meal <<Entity>> {}
    class MealType <<Value Object>> {}
    class MealItem <<Entity>> {}
    class FoodSnapshot <<Value Object>> {}
    class PortionQuantity <<Value Object>> {}
}

package "Progress & Analytics Aggregate" {
    class ProgressTracker <<Entity Root>> {}
    class WeightRecord <<Value Object>> {}
    class TrendAnalysis <<Value Object>> {}
}

User "1" *-- "1" UserId
User "1" *-- "1" Email
User "1" *-- "1" Password

UserNutritionalProfile "1" --> "0..1" User : "belongs to"
UserNutritionalProfile "1" *-- "0..1" PhysicalData
UserNutritionalProfile "1" *-- "0..1" ActivityLevel
UserNutritionalProfile "1" *-- "0..1" NutritionalGoal

NutritionalGoal "1" *-- "1" MacroBreakdown

FoodItem "1" *-- "1" FoodId
FoodItem "1" *-- "1" ProductName
FoodItem "1" *-- "0..1" Barcode
FoodItem "1" *-- "1" NutrientComposition
FoodItem "1" *-- "1" ServingSize
FoodItem "1" *-- "1" Brand

CustomRecipe "1" *-- "1" RecipeId
CustomRecipe "1" *-- "1" RecipeName
CustomRecipe "1" *-- "1..*" RecipeIngredients
CustomRecipe "1" --> "1" User : "created by"

DailyLog "1" *-- "1" DailyLogId
DailyLog "1" *-- "1" LogDate
DailyLog "1" --> "1" User : "belongs to"
DailyLog "1" *-- "0..*" Meal
DailyLog "1" --> "1" UserNutritionalProfile: "references"

Meal "1" *-- "1" MealType
Meal "1" *-- "0..*" MealItem

MealItem "1" *-- "1" FoodSnapshot
MealItem "1" *-- "1" PortionQuantity
MealItem "1" --> "0..1" CustomRecipe : "references"

ProgressTracker "1" --> "1" User : "tracks"
ProgressTracker "1" *-- "0..*" WeightRecord
ProgressTracker "1" *-- "0..1" TrendAnalysis

note bottom of User
  **User Authentication Aggregate**
- Manages user identity, email, and secure credentials.
end note

note top of UserNutritionalProfile
  **User Profile Aggregate**
- Created optionally after registration (Onboarding).
- Relates directly to the User Entity Root.
end note

@enduml
