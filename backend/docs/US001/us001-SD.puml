@startuml US001-SD
autonumber
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as Actor
participant "UI" as UI
participant ":JWT Authentication Filter" as Auth
participant ":PersonalDataController" as Ctrl
participant ":PersonalDataService" as Svc
participant ":UserRepository" as UserRepo
participant ":UserProfileRepository" as ProfileRepo
participant ":NutritionalGoalCalculatorService" as Calc
participant ":UserProfileMapper" as Mapper
participant ":UserProfileFactory" as Factory
participant ":UserNutritionalProfile" as Profile

note over Auth
  The user has already signed in. The server-issued access token contains
  the user's stable ID in its subject (sub) claim.
end note

activate Actor
Actor -> UI : submits personal data
activate UI
UI -> Auth : POST /api/profiles/personal-data\nAuthorization: Bearer <access-token>\n(body: age, weight, height, gender, activity, goal, optional body fat, units)
activate Auth

Auth -> Auth : validate token and build principal from sub
Auth -> Ctrl : forward request with authenticated principal
activate Ctrl
deactivate Auth

Ctrl -> Svc : logPersonalData(principal.userId, requestDTO)
activate Svc

Svc -> UserRepo : existsByUserId(principal.userId)
activate UserRepo
UserRepo --> Svc : user exists
deactivate UserRepo

Svc -> Factory : create and validate PhysicalData + ActivityLevel\n(normalize units at request boundary)
activate Factory
Factory --> Svc : validated physicalData, activityLevel
deactivate Factory

Svc -> Calc : calculateGoal(physicalData, activityLevel, goalType)
activate Calc
Calc -> Factory : createNutritionalGoal(maintenanceCalories, calorieTarget)
activate Factory
Factory --> Calc : validated nutritionalGoal + macros
deactivate Factory
Calc --> Svc : nutritionalGoal
deactivate Calc

Svc -> ProfileRepo : findByUserId(principal.userId)
activate ProfileRepo
ProfileRepo --> Svc : existing profile
deactivate ProfileRepo

Svc -> Profile : updateData(physicalData, activityLevel, nutritionalGoal)
activate Profile
Profile --> Svc : updated profile
deactivate Profile

Svc -> ProfileRepo : save(profile)
activate ProfileRepo
ProfileRepo --> Svc : saved profile
deactivate ProfileRepo

Svc -> Mapper : toDTO(savedProfile, confirmation)
activate Mapper
Mapper --> Svc : response DTO with goal and macros
deactivate Mapper

Svc --> Ctrl : response DTO
deactivate Svc
Ctrl --> UI : 200 OK + response DTO
deactivate Ctrl
UI --> Actor : displays updated profile and nutritional goals
deactivate UI
deactivate Actor
@enduml
